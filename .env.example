# Origen de Catsa-Api (Django), sin barra final. Solo lo usa el servidor de Next.
API_URL=http://localhost:8000
# URL pública de este sitio (metadatos, sitemap).
SITE_URL=http://localhost:3000
# Origen de las imágenes subidas (Django en local, almacenamiento de objetos en producción).
MEDIA_URL=http://localhost:8000
# Solo producción: true deja que los buscadores indexen el sitio. En cualquier otro ambiente, false.
INDEXAR=false
# Secreto compartido con Django para POST /api/revalidar (mínimo 32 caracteres).
REVALIDATE_SECRET=
